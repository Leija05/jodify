+  private void sendAudioSessionBroadcast(int audioSessionId, boolean open) {
+    if (audioSessionId > 0 && mReactContext != null) {
+      android.util.Log.i(TAG, "sendAudioSessionBroadcast triggered: sessionId=" + audioSessionId + ", open=" + open);
+      // 1. Direct in-memory invocation to JodifyEqualizerModule (fast, 100% reliable)
+      try {
+        Class<?> clazz = Class.forName("com.jodify.mobile.eq.JodifyEqualizerModule");
+        java.lang.reflect.Method method = clazz.getMethod("onAudioSession", int.class, boolean.class);
+        method.invoke(null, audioSessionId, open);
+        android.util.Log.i(TAG, "Direct invocation onAudioSession succeeded for sessionId=" + audioSessionId);
+      } catch (Throwable t) {
+        android.util.Log.w(TAG, "Direct invocation onAudioSession failed: " + t.getMessage());
+      }
+
+      // 2. Explicit broadcast targeted to this app's package
+      try {
+        String action = open
+          ? android.media.audiofx.AudioEffect.ACTION_OPEN_AUDIO_EFFECT_CONTROL_SESSION
+          : android.media.audiofx.AudioEffect.ACTION_CLOSE_AUDIO_EFFECT_CONTROL_SESSION;
+        android.content.Intent appIntent = new android.content.Intent(action);
+        appIntent.setPackage(mReactContext.getPackageName());
+        appIntent.putExtra(android.media.audiofx.AudioEffect.EXTRA_AUDIO_SESSION, audioSessionId);
+        appIntent.putExtra(android.media.audiofx.AudioEffect.EXTRA_PACKAGE_NAME, mReactContext.getPackageName());
+        mReactContext.sendBroadcast(appIntent);
+      } catch (Throwable ignored) {}
+
+      // 3. System-wide broadcast for MIUI / Dolby / system musicfx
+      try {
+        String action = open
+          ? android.media.audiofx.AudioEffect.ACTION_OPEN_AUDIO_EFFECT_CONTROL_SESSION
+          : android.media.audiofx.AudioEffect.ACTION_CLOSE_AUDIO_EFFECT_CONTROL_SESSION;
+        android.content.Intent sysIntent = new android.content.Intent(action);
+        sysIntent.putExtra(android.media.audiofx.AudioEffect.EXTRA_AUDIO_SESSION, audioSessionId);
+        sysIntent.putExtra(android.media.audiofx.AudioEffect.EXTRA_PACKAGE_NAME, mReactContext.getPackageName());
+        mReactContext.sendBroadcast(sysIntent);
+      } catch (Throwable ignored) {}
+    }
+  }
