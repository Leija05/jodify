# =========================
# MONGO (local para desarrollo)
# =========================
MONGO_URI=mongodb://localhost:27017
MONGO_DB=jodify

# =========================
# MONGO (producción: MongoDB Atlas para Render)
# Reemplaza TU_USUARIO/TU_PASSWORD/cluster por los valores de tu cluster.
# =========================
# MONGO_URI=mongodb+srv://TU_USUARIO:TU_PASSWORD@cluster0.xxxxx.mongodb.net/jodify?retryWrites=true&w=majority

