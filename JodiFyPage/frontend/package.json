{
  "name": "jodify-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "tsc -b && vite build",
    "prebuild:electron": "node scripts/sync-assets.mjs",
    "build:electron": "tsc -b && vite build --mode electron",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.5",
    "@fontsource-variable/outfit": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@phosphor-icons/react": "^2.1.7",
    "idb": "^8.0.2",
    "motion": "^12.23.6",
    "music-metadata": "^11.7.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
